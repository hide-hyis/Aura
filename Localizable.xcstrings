    "feeling.active.description" : {
      "comment" : "Description of the \"feeling.active\" feeling type.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溢れ出る喜びが、周囲を照らすポジティブな光に変わります。 弾けるようなエネルギッシュな音が、その高揚感を増幅させ、 あなたの可能性を、未知なる領域へと解き放ちます。"
          }
        }
      }
    },
    "feeling.anxious.description" : {
      "comment" : "Description of the \"anxious\" feeling type.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高まった熱量は、あなたの秘めたる活力の証です。 包み込むような丸い音色が、その波動を優しく整え、 穏やかな静寂へと、心地よく着地させていきます。"
          }
        }
      }
    },
    "feeling.flow.description" : {
      "comment" : "Description of the \"flow\" feeling type.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深い静けさは、心が新しく生まれ変わるための休息です。 透明な水滴のような音の粒が、内なる淀みを浄化し、 雨上がりのような、清々しい視界を広げてくれます。"
          }
        }
      }
    },
    "feeling.serene.description" : {
      "comment" : "Description of the \"serene\" feeling.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今、あなたの心は一点の曇りもない調和の中にあります。 安定したリズムが、この高い集中力と平穏を維持し、 深く、長く、洗練されたパフォーマンスを支え続けます。"
          }
        }
      }
    },
